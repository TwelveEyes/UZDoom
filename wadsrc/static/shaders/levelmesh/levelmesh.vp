**---------------------------------------------------------------------------
**
** The vertex-stage variant of the shader matrix for the levelmesh: vertices
** are pulled from the LevelMeshSet (gl_VertexIndex is the mesh vertex index)
** and every output the shared main.fp reads is produced exactly as main.vp
** produces it, in the same order of operations, so depth and clipping
** match the classic path. Per-surface material data travels as one flat
** varying (vLMMaterial, see lm_frag.glsl), the surface's resolved shading
** (resolve.comp) as the flat vLMLight / vLMFog / vLMGlow* / vLMFogMode,
** standing in for the render state values the classic draw sets.
*/

#include "shaders/levelmesh/lm_data.glsl"

layout(location = LM_MATERIAL_LOCATION) flat out uvec4 vLMMaterial;
layout(location = LM_SHADE_LOCATION) flat out vec4 vLMLight;		// uLightLevel, uFogDensity, uLightFactor, uLightDist
layout(location = LM_SHADE_LOCATION + 1) flat out vec4 vLMFog;		// uFogColor.rgb, uDesaturationFactor
layout(location = LM_SHADE_LOCATION + 2) flat out vec4 vLMGlowTop;	// uGlowTopColor
layout(location = LM_SHADE_LOCATION + 3) flat out vec4 vLMGlowBottom;	// uGlowBottomColor
layout(location = LM_SHADE_LOCATION + 4) flat out int vLMFogMode;	// uFogEnabled

// FRenderState::SetColor / SetFog: a PalEntry channel as a float.
float LM_Channel(uint c, uint shift)
{
	const float scale = 1.0 / 255.0;
	return float((c >> shift) & 0xffu) * scale;
}

// Wall texture v: anchored to the texture-top plane (LevelMeshBake::VertexV).
float LM_WallV(LMVertex v, LMSurface surf, float z)
{
	if (surf.vRef == LM_NOPLANE) return v.vOffset + surf.vScale * z;
	float texz = lmSectors[surf.vRef >> 1].texZ[surf.vRef & 1u];
	return v.vOffset + surf.vScale * (z - texz);
}

// FTexCoordInfo::TextureOffset / RowOffset of a side offset, as texture
// coordinates (FloatToTexU / the texturetop term of FloatToTexV). Two-sided
// mid textures first wrap the x offset into the texture width
// (HWWall::DoMidTexture).
float LM_WallU(LMSurface surf, float xoffset)
{
	float t = xoffset;
	if (surf.wrapWidth > 0.0)
	{
		float texwidth = surf.wrapWidth;
		if (t >= 0.0)
		{
			float div = t / texwidth;
			t = (div - floor(div)) * texwidth;
		}
		else
		{
			float div = (-t) / texwidth;
			t = texwidth - (div - floor(div)) * texwidth;
		}
	}
	return (t / surf.texOffsetScale) / surf.renderWidth;
}

// Wall texture coordinates with the side tier's current offsets: the baked
// u / v hold the offsets at bake (LevelMeshSurface::xOffsetBase), so only
// the difference is applied. v = (texturetop - z) / mRenderHeight, and
// vScale = dv/dz = -1 / mRenderHeight.
vec2 LM_WallTexCoord(LMVertex v, LMSurface surf, float z)
{
	vec2 tc = vec2(v.u, LM_WallV(v, surf, z));
	if (surf.sideRef == 0xffffffffu || surf.renderWidth == 0.0) return tc;
	LMSideState ss = lmSides[surf.sideRef];
	if (ss.xOffset != surf.xOffsetBase)
		tc.x += LM_WallU(surf, ss.xOffset) - LM_WallU(surf, surf.xOffsetBase);
	if (ss.yOffset != surf.yOffsetBase)
		tc.y -= (ss.yOffset / surf.rowOffsetScale - surf.yOffsetBase / surf.rowOffsetScale) * surf.vScale;
	return tc;
}

// Flat texture coordinates: the classic plane texture matrix
// (hw_SetPlaneTextureRotation: scale1 * translate * scale2 * rotate),
// expanded into the same products the VSMatrix calls produce.
vec2 LM_FlatTexCoord(LMVertex v, LMSurface surf, LMTextureEntry tex)
{
	LMPlaneXform xf = lmPlaneXforms[surf.planeRefs[0]];
	float w = tex.displayWidth > 0.0 ? tex.displayWidth : 64.0;
	float h = tex.displayHeight > 0.0 ? tex.displayHeight : 64.0;
	float uoffs = xf.xOffset / w;
	float voffs = (xf.yOffset + xf.baseyOffset) / h;
	float a = xf.xScale * (64.0 / w);
	float b = xf.yScale * (64.0 / h);
	float rad = radians(-(xf.angle + xf.baseAngle));
	float co = cos(rad);
	float si = sin(rad);
	return vec2((a * co) * v.u + (-(a * si)) * v.vOffset + xf.xScale * uoffs,
		(b * si) * v.u + (b * co) * v.vOffset + xf.yScale * voffs);
}

void main()
{
	float ClipDistance0, ClipDistance1, ClipDistance2, ClipDistance3, ClipDistance4;

	LMVertex v = lmVertices[gl_VertexIndex];
	LMSurface surf = lmSurfaces[v.surface];
	// Polyobject walls: placed before the planes are evaluated, so their z
	// follows the planes where the polyobject is now.
	vec2 xy = LM_VertexXY(v, surf);
	v.x = xy.x;
	v.y = xy.y;
	uint ref = v.anchor & LMV_REFMASK;
	float z = LM_PlaneZ(lmSectors[ref >> 1].planes[ref & 1u], v.x, v.y) + v.zOffset;

	LMTextureEntry tex = lmTextures[LM_SurfaceTexture(surf)];
	uint kind = surf.flags & LMSF_KINDMASK;
	// The classic tier clamp (LevelMeshSurface::edgeClamp), then a wall tier
	// whose planes crossed collapses (edgeTop). LevelMeshBake::VertexZ is
	// the CPU reference.
	uint role = v.anchor >> LMV_ROLESHIFT;
	if (kind == LMSK_WALL && surf.edgeClamp != LM_NOPLANE)
	{
		float cz = LM_PlaneZ(lmSectors[surf.edgeClamp >> 1].planes[surf.edgeClamp & 1u], v.x, v.y);
		if ((surf.flags & LMSF_EDGECLAMPMAX) != 0u) { if (role == LMV_BOTTOM) z = max(z, cz); }
		else if (role == LMV_TOP) z = min(z, cz);
	}
	if (kind == LMSK_WALL && surf.edgeTop != LM_NOPLANE && role != LMV_TOP)
		z = min(z, LM_PlaneZ(lmSectors[surf.edgeTop >> 1].planes[surf.edgeTop & 1u], v.x, v.y));
	vec2 tc;
	if (kind == LMSK_WALL) tc = LM_WallTexCoord(v, surf, z);
	else tc = LM_FlatTexCoord(v, surf, tex);

	// Material for the fragment stage: bindless base slot, layer count,
	// sampler (classic clamp mode: walls pass HWF_CLAMPX/Y, flats CLAMP_NONE)
	// | texture-mode flags (material layers + ClampY, see LMSF_TEXCLAMPY),
	// material shader timer.
	uint samplerMode = 0u;
	uint texflags = tex.layers & LMTE_TEXFMASK;
	uint program = (surf.flags & LMSF_PROGRAMMASK) >> LMSF_PROGRAMSHIFT;
	// FGameTexture::GetClampMode: warped textures never clamp.
	if (kind == LMSK_WALL && program == LMP_DEFAULT)
	{
		// The classic sets HWF_CLAMPX only while the u range lies within one
		// texture width (HWWall::DoMidTexture, CheckTexturePosition for
		// skybox sectors); a side scrolled in x is taken to leave it.
		bool scrolledX = surf.sideRef != 0xffffffffu && surf.renderWidth != 0.0 && lmSides[surf.sideRef].xOffset != surf.xOffsetBase;
		if ((surf.flags & LMSF_CLAMPX) != 0u && !scrolledX) samplerMode |= 1u;
		if ((surf.flags & LMSF_CLAMPY) != 0u) samplerMode |= 2u;
		if ((surf.flags & LMSF_TEXCLAMPY) != 0u) texflags |= LM_TEXF_CLAMPY;
	}
	// VkRenderState::ApplyStreamData: timer = (FrameTime - firstFrame) * GetShaderSpeed() / 1000.
	float materialTimer = uLevelMeshTime * tex.shaderSpeed;
	vLMMaterial = uvec4(tex.slot, tex.layers & 0xffffu, samplerMode | texflags, floatBitsToUint(materialTimer));

	vec4 worldcoord = ModelMatrix * vec4(v.x, z, v.y, 1.0);
	vec4 eyeCoordPos = ViewMatrix * worldcoord;

	// Shading: the resolved record of the surface, or (lm_shading 0) the
	// render state's fullbright light for everything.
	vec4 glowTop = vec4(0.0), glowBottom = vec4(0.0);
	if ((uLevelMeshFlags & LMVF_FULLBRIGHT) != 0)
	{
		vColor = uVertexColor;
		vLMLight = vec4(uLightLevel, uFogDensity, uLightFactor, uLightDist);
		vLMFog = vec4(uFogColor.rgb, uDesaturationFactor);
		vLMFogMode = uFogEnabled;
	}
	else
	{
		LMResolved res = lmResolved[v.surface];
		// FRenderState::SetColorAlpha: the levelmesh draws opaque and masked surfaces (alpha 1).
		vColor = vec4(LM_Channel(res.color, 0u), LM_Channel(res.color, 8u), LM_Channel(res.color, 16u), 1.0);
		vLMLight = vec4(res.softLight, res.fogDensity, res.lightFactor, res.lightDist);
		vLMFog = vec4(LM_Channel(res.fogColor, 16u), LM_Channel(res.fogColor, 8u), LM_Channel(res.fogColor, 0u), LM_Channel(res.color, 24u));
		vLMFogMode = res.fogMode;
		if ((res.glow & 1u) != 0u)
		{
			// HWWall::RenderTexturedWall: sector_t::GetWallGlow of the front sector.
			LMSectorState gs = lmSectors[surf.lightSector];
			glowTop = vec4(gs.glowTop[0], gs.glowTop[1], gs.glowTop[2], gs.glowTop[3]);
			glowBottom = vec4(gs.glowBottom[0], gs.glowBottom[1], gs.glowBottom[2], gs.glowBottom[3]);
		}
	}
	vLMGlowTop = glowTop;
	vLMGlowBottom = glowBottom;

	vLightmap = vec3(v.lu, v.lv, float(surf.lightmapPage));

	pixelpos.xyz = worldcoord.xyz;
	pixelpos.w = -eyeCoordPos.z/eyeCoordPos.w;

	if (glowTop.a > 0 || glowBottom.a > 0)
	{
		// SetGlowPlanes(frontsector->ceilingplane, frontsector->floorplane)
		LMSectorState gs = lmSectors[surf.lightSector];
		float topatpoint = (gs.planes[1].d + gs.planes[1].nx * worldcoord.x + gs.planes[1].ny * worldcoord.z) * gs.planes[1].negiC;
		float bottomatpoint = (gs.planes[0].d + gs.planes[0].nx * worldcoord.x + gs.planes[0].ny * worldcoord.z) * gs.planes[0].negiC;
		glowdist.x = topatpoint - worldcoord.y;
		glowdist.y = worldcoord.y - bottomatpoint;
		glowdist.z = clamp(glowdist.x / (topatpoint - bottomatpoint), 0.0, 1.0);
	}

	if (uObjectColor2.a != 0)
	{
		float topatpoint = (uGradientTopPlane.w + uGradientTopPlane.x * worldcoord.x + uGradientTopPlane.y * worldcoord.z) * uGradientTopPlane.z;
		float bottomatpoint = (uGradientBottomPlane.w + uGradientBottomPlane.x * worldcoord.x + uGradientBottomPlane.y * worldcoord.z) * uGradientBottomPlane.z;
		gradientdist.x = topatpoint - worldcoord.y;
		gradientdist.y = worldcoord.y - bottomatpoint;
		gradientdist.z = clamp(gradientdist.x / (topatpoint - bottomatpoint), 0.0, 1.0);
	}

	if (uSplitBottomPlane.z != 0.0)
	{
		ClipDistance3 = ((uSplitTopPlane.w + uSplitTopPlane.x * worldcoord.x + uSplitTopPlane.y * worldcoord.z) * uSplitTopPlane.z) - worldcoord.y;
		ClipDistance4 = worldcoord.y - ((uSplitBottomPlane.w + uSplitBottomPlane.x * worldcoord.x + uSplitBottomPlane.y * worldcoord.z) * uSplitBottomPlane.z);
	}

	// Surface normals are in map space (x, y, z); GL world space is (x, z, y).
	vec3 mapNormal = LM_SurfaceNormal(surf);
	vec3 normal = vec3(mapNormal.x, mapNormal.z, mapNormal.y);
	vWorldNormal = vec4(normalize((NormalModelMatrix * vec4(normal, 1.0)).xyz), 1.0);
	vEyeNormal = vec4(normalize((NormalViewMatrix * vec4(normalize(vWorldNormal.xyz), 1.0)).xyz), 1.0);

	vTexCoord = vec4(tc, 0.0, 1.0);

	gl_Position = ProjectionMatrix * eyeCoordPos;
	gl_Position.z = (gl_Position.z + gl_Position.w) / 2.0;
	// The classic path draws this surface for now (LMTS_DEFERRED): every
	// vertex outside the clip volume, so its triangles are clipped away.
	if (LM_StateDeferred(surf)) gl_Position = vec4(2.0, 2.0, 2.0, 1.0);

	if (uClipHeightDirection != 0.0) // clip planes used for reflective flats
	{
		ClipDistance0 = (worldcoord.y - uClipHeight) * uClipHeightDirection;
	}
	else if (uClipLine.x > -1000000.0) // line portals
	{
		ClipDistance0 = -( (worldcoord.z - uClipLine.y) * uClipLine.z + (uClipLine.x - worldcoord.x) * uClipLine.w ) + 1.0/32768.0;
	}
	else
	{
		ClipDistance0 = 1;
	}

	ClipDistance1 = worldcoord.y - uClipSplit.x;
	ClipDistance2 = uClipSplit.y - worldcoord.y;

	if (uSplitTopPlane == vec4(0.0))
	{
		ClipDistance3 = 1.0;
		ClipDistance4 = 1.0;
	}

#ifdef NO_CLIPDISTANCE_SUPPORT
	ClipDistanceA = vec4(ClipDistance0, ClipDistance1, ClipDistance2, ClipDistance3);
	ClipDistanceB = vec4(ClipDistance4, 0.0, 0.0, 0.0);
#else
	gl_ClipDistance[0] = ClipDistance0;
	gl_ClipDistance[1] = ClipDistance1;
	gl_ClipDistance[2] = ClipDistance2;
	gl_ClipDistance[3] = ClipDistance3;
	gl_ClipDistance[4] = ClipDistance4;
#endif
}
