/*
** scatter.comp
**
** Levelmesh dirty state scatter: sector, side, plane-xform, 3D-light and
** polyobject records and cluster boxes
**
**---------------------------------------------------------------------------
**
** Copyright 2025-2026 UZDoom Maintainers and Contributors
**
** SPDX-License-Identifier: GPL-3.0-or-later
**
**---------------------------------------------------------------------------
**
** One dispatch per state update (VkLevelMesh::UpdateState). The staging
** buffer holds, at the pushed word offsets, per record kind the indices and
** the records (parallel to the indices): sectors (LM_SECTOR_WORDS each),
** side tiers (LM_SIDE_WORDS), plane xforms (LM_XFORM_WORDS), 3D lights
** (LM_LIGHT3D_WORDS), polyobjects (LM_POLYOBJ_WORDS); then the cluster box
** entries (LevelMeshClusterBox: cluster, bmin[3], bmax[3], reserved).
** Every invocation copies one record word or one cluster box; the indices
** of a kind are unique, so no two invocations write the same word.
*/

layout(local_size_x = 64) in;

layout(set = 0, binding = LMBIND_SECTORSTATE, std430) buffer SectorWords { uint sectorWords[]; };
layout(set = 0, binding = LMBIND_CLUSTERS, std430) buffer ClusterWords { uint clusterWords[]; };
layout(set = 0, binding = LMBIND_SIDESTATE, std430) buffer SideWords { uint sideWords[]; };
layout(set = 0, binding = LMBIND_PLANEXFORM, std430) buffer XformWords { uint xformWords[]; };
layout(set = 0, binding = LMBIND_LIGHTS3D, std430) buffer Light3DWords { uint light3DWords[]; };
layout(set = 0, binding = LMBIND_POLYOBJS, std430) buffer PolyobjWords { uint polyWords[]; };
layout(set = 1, binding = 0, std430) buffer readonly SourceWords { uint src[]; };

// Keep in sync with VkLevelMesh::ScatterConstants.
layout(push_constant) uniform ScatterConstants
{
	uint sectorIndices;
	uint sectorRecords;
	uint numSectors;
	uint clusterEntries;
	uint numClusters;
	uint sideIndices;
	uint sideRecords;
	uint numSides;
	uint xformIndices;
	uint xformRecords;
	uint numXforms;
	uint light3DIndices;
	uint light3DRecords;
	uint numLights3D;
	uint polyIndices;
	uint polyRecords;
	uint numPolys;
	uint padding0;
	uint padding1;
	uint padding2;
};

void main()
{
	uint sectorItems = numSectors * LM_SECTOR_WORDS;
	uint sideItems = numSides * LM_SIDE_WORDS;
	uint xformItems = numXforms * LM_XFORM_WORDS;
	uint light3DItems = numLights3D * LM_LIGHT3D_WORDS;
	uint polyItems = numPolys * LM_POLYOBJ_WORDS;
	uint total = sectorItems + sideItems + xformItems + light3DItems + polyItems + numClusters;
	uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
	for (uint i = gl_GlobalInvocationID.x; i < total; i += stride)
	{
		if (i < sectorItems)
		{
			uint record = i / LM_SECTOR_WORDS;
			uint word = i - record * LM_SECTOR_WORDS;
			uint sector = src[sectorIndices + record];
			sectorWords[sector * LM_SECTOR_WORDS + word] = src[sectorRecords + i];
			continue;
		}
		uint k = i - sectorItems;
		if (k < sideItems)
		{
			uint record = k / LM_SIDE_WORDS;
			uint word = k - record * LM_SIDE_WORDS;
			uint side = src[sideIndices + record];
			sideWords[side * LM_SIDE_WORDS + word] = src[sideRecords + k];
			continue;
		}
		k -= sideItems;
		if (k < xformItems)
		{
			uint record = k / LM_XFORM_WORDS;
			uint word = k - record * LM_XFORM_WORDS;
			uint plane = src[xformIndices + record];
			xformWords[plane * LM_XFORM_WORDS + word] = src[xformRecords + k];
			continue;
		}
		k -= xformItems;
		if (k < light3DItems)
		{
			uint record = k / LM_LIGHT3D_WORDS;
			uint word = k - record * LM_LIGHT3D_WORDS;
			uint light = src[light3DIndices + record];
			light3DWords[light * LM_LIGHT3D_WORDS + word] = src[light3DRecords + k];
			continue;
		}
		k -= light3DItems;
		if (k < polyItems)
		{
			uint record = k / LM_POLYOBJ_WORDS;
			uint word = k - record * LM_POLYOBJ_WORDS;
			uint poly = src[polyIndices + record];
			polyWords[poly * LM_POLYOBJ_WORDS + word] = src[polyRecords + k];
			continue;
		}
		k -= polyItems;
		uint e = clusterEntries + k * LM_CLUSTERBOX_WORDS;
		uint c = src[e];
		for (uint j = 0u; j < 3u; j++)
		{
			clusterWords[c * LM_CLUSTER_WORDS + LM_CLUSTER_BMIN + j] = src[e + 1u + j];
			clusterWords[c * LM_CLUSTER_WORDS + LM_CLUSTER_BMAX + j] = src[e + 4u + j];
		}
	}
}
