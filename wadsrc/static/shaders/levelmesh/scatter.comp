**---------------------------------------------------------------------------
**
** One dispatch per state update (VkLevelMesh::UpdateState). The staging
** buffer holds, at the pushed word offsets: the sector indices, the sector
** records (LM_SECTOR_WORDS each, parallel to the indices) and the cluster
** z entries (LevelMeshClusterZ: cluster, zmin, zmax, reserved). Every
** invocation copies one word of a sector record or one cluster z-range;
** the indices are unique, so no two invocations write the same word.
*/

layout(local_size_x = 64) in;

layout(set = 0, binding = LMBIND_SECTORSTATE, std430) buffer SectorWords { uint sectorWords[]; };
layout(set = 0, binding = LMBIND_CLUSTERS, std430) buffer ClusterWords { uint clusterWords[]; };
layout(set = 1, binding = 0, std430) buffer readonly SourceWords { uint src[]; };

// Keep in sync with VkLevelMesh::ScatterConstants.
layout(push_constant) uniform ScatterConstants
{
	uint sectorIndices;
	uint sectorRecords;
	uint numSectors;
	uint clusterEntries;
	uint numClusters;
	uint padding0, padding1, padding2;
};

void main()
{
	uint sectorItems = numSectors * LM_SECTOR_WORDS;
	uint total = sectorItems + numClusters;
	uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
	for (uint i = gl_GlobalInvocationID.x; i < total; i += stride)
	{
		if (i < sectorItems)
		{
			uint record = i / LM_SECTOR_WORDS;
			uint word = i - record * LM_SECTOR_WORDS;
			uint sector = src[sectorIndices + record];
			sectorWords[sector * LM_SECTOR_WORDS + word] = src[sectorRecords + i];
		}
		else
		{
			uint e = clusterEntries + (i - sectorItems) * LM_CLUSTERZ_WORDS;
			uint c = src[e];
			clusterWords[c * LM_CLUSTER_WORDS + LM_CLUSTER_ZMIN] = src[e + 1u];
			clusterWords[c * LM_CLUSTER_WORDS + LM_CLUSTER_ZMAX] = src[e + 2u];
		}
	}
}
