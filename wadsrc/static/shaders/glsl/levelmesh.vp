/*
** levelmesh.vp
**
** Vertex shader for the levelmesh path (ticket 03, chunk C1b).
**
** This is the main body of the levelmesh vertex shader. It is concatenated
** by the engine (gl_shader.cpp) AFTER the standard prelude: the `#version`
** line, the ViewpointUBO (ViewMatrix / ProjectionMatrix / NormalViewMatrix),
** the i_data uniform block (ModelMatrix / uGlow* / uLightAttr / ...), and the
** standard `in` attributes + `out` varyings generated by
** ShaderInputsOutputs::GenerateInputsOutputs (hw_shaderpatcher.cpp:342-365).
**
** Therefore this file MUST NOT re-declare:
**   - any standard attribute (aPosition, aTexCoord, aColor, aVertex2, aNormal,
**     aNormal2, aLightmap, aBoneWeight, aBoneSelector)
**   - any standard varying (vTexCoord, vColor, pixelpos, glowdist, gradientdist,
**     vWorldNormal, vEyeNormal, ClipDistanceA, ClipDistanceB, vLightmap)
**   - any i_data / ViewpointUBO uniform (ModelMatrix, ViewMatrix,
**     ProjectionMatrix, NormalViewMatrix, NormalModelMatrix, TextureMatrix,
**     uGlow*, uLightAttr, uFogEnabled, uInterpolationFactor, ...)
**
** It only declares the levelmesh-specific uniforms, the promoted per-surface
** varyings, the record-fetch helpers, and main().
**
** ATTRIBUTE MAPPING (the 32-byte LevelMeshVertex, levelmesh.h:80-87; the C2
** chunk binds the vertex buffer to match):
**   aPosition.xyz = (x, y, slotA)   slotA = baked z (static) / vparam (dynamic)
**   aTexCoord.xy  = (u, slotB)      slotB = baked v (static) / 0 (dynamic)
**   aLightmap.xy  = (lmu, lmv)      lightmap UVs
**   aLightmap.z   = surfaceIndex    uint32 index into the surface record pool
**   aNormal.xyz   = world normal (GPU space, y-up); the C2 chunk provides it
**
** RECORD LAYOUT (the C3/C4 chunk uploads re-packed float arrays; see the
** "RECORD LAYOUT" banner below for the exact per-float order). The records are
** packed byte-structs in C++ (int16 = 2 bytes), but GLSL 330 has no
** float<->uint bit-cast, so the host stores every field as a full float32
** (int values are small and exactly representable). Each record is therefore
** a small array of float32s fetched through a samplerBuffer.
**
**---------------------------------------------------------------------------
**
** Copyright 2026 UZDoom Maintainers and Contributors
**
** SPDX-License-Identifier: GPL-3.0-or-later
**
**---------------------------------------------------------------------------
**
*/

//
// UNIFORMS
//
// Levelmesh-specific uniforms. None of these collide with the i_data /
// ViewpointUBO names (note: the level fog density is named uLevelFogDensity,
// NOT uFogDensity, which is #defined to uLightAttr.b by i_data).
//

// Per-level per-frame sky scroll triple (hw_sky1pos, hw_sky2pos, hw_skymistpos),
// advanced by R_UpdateSky (r_sky.cpp:146-148). Selects scroll by skyScrollKind.
uniform vec3 uLevelSkyPos;

// Light-mode for the level (ELightMode, doomtype.h:52-63).
uniform int uLightMode;

// Per-level fog/cull state (FLevelLocals).
uniform float uLevelFogDensity;       // FLevelLocals::fogdensity
uniform float uOutsideFogDensity;     // FLevelLocals::outsidefogdensity
uniform uint  uOutsideFog;            // FLevelLocals::info->outsidefog
uniform uint  uLevelFlags3;           // FLevelLocals::flags3 (LEVEL3_NOLIGHTFADE, ...)
uniform uint  uLevelFlags2;           // FLevelLocals::flags2 (LEVEL2_SMOOTHLIGHTING)
uniform uint  uLevelFlags;            // FLevelLocals::flags (LEVEL_HASFADETABLE)
uniform int   uSkyfog;                // FLevelLocals::skyfog
uniform float uCullDist;              // FLevelLocals::culldist
// Global cvars.
uniform vec4  uGlCullColor;           // gl_cullcolor (r_utility.cpp:174)
uniform int   uRDistanceCullType;     // r_distance_cull_type
uniform int   uGlFogMode;             // gl_fogmode
uniform float uRVisibility;           // r_visibility
uniform int   uRExtralight;           // r_extralight
uniform int   uWeaponLight;           // r_viewpoint.extralight * gl_weaponlight
uniform int   uRFakeContrast;         // r_fakecontrast (0 off, 1 classic, 2 smooth)
uniform int   uWallHorizLight;        // FLevelLocals::WallHorizLight (smooth)
uniform int   uWallVertLight;         // FLevelLocals::WallVertLight (smooth)
uniform bool  uInsybox;               // portalState.inskybox (skybox fog boost)

// Record pools (re-packed float32 arrays; see RECORD LAYOUT below).
uniform samplerBuffer uSurface;       // FLevelMesh::surfaces  (5 floats x 4 = 20, 1 pad)
uniform samplerBuffer uSectorState;   // FLevelMeshState::sectorRing (6 floats x 4 = 24)
uniform samplerBuffer uLightState;    // FLevelMeshState::lightData (3 floats x 4 = 12)
uniform int   uSectorStateSlot;       // current frame's ring slot
uniform int   uSectorCount;           // number of sectors in the ring
uniform int   uSurfaceCount;          // number of surface records

//
// VARYINGS
//
// The standard varyings (vTexCoord, vColor, pixelpos, glowdist, gradientdist,
// vWorldNormal, vEyeNormal, vLightmap, ...) are declared by the engine prelude;
// they are assigned in main() below but NOT declared here.
//
// Promoted per-surface varyings (blueprint section 3.4): the light chain, fog,
// and glow values are computed in the VS (they are per-surface, not
// per-vertex) and passed to the fragment shader, which applies the Doom
// lighting / fog / glow equations.
//
out float vLightLevel;     // CalcLightLevel result (0-255)
out float vFogDensity;     // GetFogDensity result
out vec4  vFogColor;       // fog color (A=0 for regular fog)
out float vLightFactor;    // SetShaderLight lightfactor
out float vLightDist;      // SetShaderLight lightdist
out float vDesaturation;   // cm.Desaturation (0-31)
out int   vFogEnabled;     // 0 none; +gl_fogmode black; -gl_fogmode colored
out vec4  vGlowTopPlane;   // frontsector ceiling plane (nx, nz, ny, D)
out vec4  vGlowBottomPlane;// frontsector floor plane   (nx, nz, ny, D)
out vec4  vGlowTopColor;   // top glow color (A = height)
out vec4  vGlowBottomColor;// bottom glow color (A = height)

//
// MACROS
//
// ESurfaceFlags bits (levelmesh.h:42-60).
#define LMF_DYNAMIC       1
#define LMF_SKY           2
#define LMF_LIGHTMAP      4
#define LMF_ISFLAT        8
#define LMF_OPENING_UPPER   16
#define LMF_OPENING_MIDDLE  32
#define LMF_OPENING_LOWER   64
#define LMF_UNPEGGEDLOWER  128
#define LMF_TIER_MASK     0x300   // bits 8-9
#define LMF_POLYOBJ       1024
#define LMF_3DFLOOR       4096
#define LMF_FAKECONTRAST  8192
#define LM_PLANEREF_NONE  0xFFFFFFFFu

// LEVEL3_NOLIGHTFADE (g_levellocals.h) and LEVEL2_SMOOTHLIGHTING bit values.
// These must match the C++ enum; the host also passes the raw flags words.
#define LEVEL3_NOLIGHTFADE  (1u << 0)
#define LEVEL2_SMOOTHLIGHTING (1u << 0)

//
// TYPES
//
struct LMPlane
{
	vec3  normal;   // DOOM space (nx, ny, nz), nz = up component
	float D;        // plane constant
	float texZ;     // interpolated TexZ
};

struct LMSectorState
{
	LMPlane floor;
	LMPlane ceil;
	vec2    floorScroll;   // floor UV offset (applied in VS)
	vec2    ceilScroll;    // ceiling UV offset (applied in VS)
	float   lightlevel;   // raw sec->lightlevel
	float   planeLight[2];
	float   flags;        // bit1 floor ABSLIGHTING, bit2 ceil ABSLIGHTING
	vec4    glowFloorColor;  // ABGR 0-255; 0 = texture-glow fallback, ~0u = disabled
	float   glowFloorHeight;
	vec4    glowCeilColor;   // ABGR 0-255; same sentinels
	float   glowCeilHeight;
	vec3    cmLightColor;  // 0-255
	float   cmBlendFactor;
	float   cmDesaturation;
	vec3    cmFadeColor;   // 0-255
	float   cmFogDensity;
};

struct LMSurface
{
	float textureIndex;
	float regionIndex;
	float planeRef[4];   // [0] front floor, [1] front ceil, [2] back floor, [3] back ceil
	float lightRef;
	float flags;
	float vparam[4];
	float light;
	float tierLight;
	float relSmooth;
	float relNonSmooth;
	float lightlistRef;
	float bandOffset;
	float bandCount;
	float skyScrollKind;
	float skyScrollKind2;
};

//
// CODE
//
// Record fetch helpers. The host uploads each record as a contiguous array of
// float32s (one per field, in the order below). texelFetch on a samplerBuffer
// returns one float4 per texel; each record spans a fixed number of texels.

// Surface record: 21 fields -> 6 float4 texels (24 slots, 3 reserved).
LMSurface LMFetchSurface(int index)
{
	vec4 a = texelFetch(uSurface, index * 6 + 0);
	vec4 b = texelFetch(uSurface, index * 6 + 1);
	vec4 c = texelFetch(uSurface, index * 6 + 2);
	vec4 d = texelFetch(uSurface, index * 6 + 3);
	vec4 e = texelFetch(uSurface, index * 6 + 4);
	vec4 f = texelFetch(uSurface, index * 6 + 5);

	LMSurface s;
	s.textureIndex  = a.x;
	s.regionIndex   = a.y;
	s.planeRef[0]   = a.z;
	s.planeRef[1]   = a.w;
	s.planeRef[2]   = b.x;
	s.planeRef[3]   = b.y;
	s.lightRef      = b.z;
	s.flags         = b.w;
	s.vparam[0]     = c.x;
	s.vparam[1]     = c.y;
	s.vparam[2]     = c.z;
	s.vparam[3]     = c.w;
	s.light         = d.x;
	s.tierLight     = d.y;
	s.relSmooth     = d.z;
	s.relNonSmooth  = d.w;
	s.lightlistRef  = e.x;
	s.bandOffset    = e.y;
	s.bandCount     = e.z;
	s.skyScrollKind = e.w;
	s.skyScrollKind2 = f.x;
	return s;
}

// Sector state: 96-byte spec section 4 record, re-packed to float32 slots by the
// host (chunk D). 35 floats -> 9 float4 texels (36 slots, 1 reserved). The slot
// order is the canonical field order of the C++ LevelMeshSectorState
// (handoff-b-fix.md): floorPlane[4] ceilPlane[4] floorScroll[2] ceilScroll[2]
// lightlevel planeLight[2] flags glowFloorColor(ABGR) glowFloorHeight
// glowCeilColor(ABGR) glowCeilHeight colormap[9] (LightColor3 Blend Desat Fade3 FogDen).
// For a standard flat the plane's base TexZ == its D constant, so texZ = D here;
// the C++ bakes vparam from that same base TexZ, keeping the two consistent.
// The ring is slot-major: offset = uSectorStateSlot * uSectorCount + sectorIndex.
LMSectorState LMFetchSector(int sectorIndex)
{
	int idx = uSectorStateSlot * uSectorCount + sectorIndex;
	vec4 a = texelFetch(uSectorState, idx * 9 + 0);   // floorPlane[4] (nx,ny,nz,D)  [0-3]
	vec4 b = texelFetch(uSectorState, idx * 9 + 1);   // ceilPlane[4]  (nx,ny,nz,D)  [4-7]
	vec4 c = texelFetch(uSectorState, idx * 9 + 2);   // floorScroll[2] ceilScroll[2] [8-11]
	vec4 d = texelFetch(uSectorState, idx * 9 + 3);   // lightlevel planeLight[2] flags [12-15]
	vec4 e = texelFetch(uSectorState, idx * 9 + 4);   // glowFloorColor[4] ABGR 0-255 [16-19]
	vec4 f = texelFetch(uSectorState, idx * 9 + 5);   // glowFloorHeight glowCeilColor[3] [20-23]
	vec4 g = texelFetch(uSectorState, idx * 9 + 6);   // glowCeilColor[3] glowCeilHeight cmLightColor[2] [24-27]
	vec4 h = texelFetch(uSectorState, idx * 9 + 7);   // cmLightColor[2] cmBlend cmDesat cmFade[1] [28-31]
	vec4 i = texelFetch(uSectorState, idx * 9 + 8);   // cmFade[2] cmFogDensity reserved [32-35]

	LMSectorState s;
	s.floor.normal = a.xyz;
	s.floor.D      = a.w;
	s.floor.texZ   = a.w;   // base TexZ == D for a flat
	s.ceil.normal  = b.xyz;
	s.ceil.D       = b.w;
	s.ceil.texZ    = b.w;
	s.floorScroll  = c.xy;
	s.ceilScroll   = c.zw;
	s.lightlevel   = d.x;
	s.planeLight[0]= d.y;
	s.planeLight[1]= d.z;
	s.flags        = d.w;
	s.glowFloorColor = e;               // ABGR 0-255 (swapped to RGBA at use)
	s.glowFloorHeight = f.x;
	s.glowCeilColor  = vec4(f.yzw, g.x);// ABGR 0-255 (4th byte in texel 6)
	s.glowCeilHeight = g.y;
	s.cmLightColor   = vec3(g.zw, h.x);// 0-255
	s.cmBlendFactor  = h.y;
	s.cmDesaturation = h.z;
	s.cmFadeColor    = vec3(h.w, i.xy);// 0-255
	s.cmFogDensity   = i.z;
	return s;
}

// Light state: 10 fields -> 3 float4 texels (12 slots, 2 reserved).
LMSectorState LMFetchLight(int index)
{
	vec4 a = texelFetch(uLightState, index * 3 + 0);
	vec4 b = texelFetch(uLightState, index * 3 + 1);
	vec4 c = texelFetch(uLightState, index * 3 + 2);

	LMSectorState s;
	s.lightlevel   = a.x;
	s.cmLightColor = a.yzw;
	s.cmBlendFactor  = b.x;
	s.cmDesaturation = b.y;
	s.cmFadeColor    = vec3(b.z, b.w, c.x);
	s.cmFogDensity   = c.y;
	// plane fields unused for the 12-byte light record.
	s.floor.normal = vec3(0.0); s.floor.D = 0.0; s.floor.texZ = 0.0;
	s.ceil.normal  = vec3(0.0); s.ceil.D  = 0.0; s.ceil.texZ  = 0.0;
	s.planeLight[0]= 0.0; s.planeLight[1]= 0.0;
	return s;
}

// Pick the floor or ceiling plane out of a sector state (planeBit 0/1).
LMPlane LMGetPlane(LMSectorState st, int planeBit)
{
	if (planeBit == 0) return st.floor;
	return st.ceil;
}

// planeRef -> (sectorIndex, planeBit). Returns false for LM_PLANEREF_NONE.
bool LMSplitPlaneRef(float planeRef, out int sectorIndex, out int planeBit)
{
	uint pr = uint(planeRef);
	if (pr == LM_PLANEREF_NONE) return false;
	sectorIndex = int(pr >> 1);
	planeBit    = int(pr & 1u);
	return true;
}

// A zero plane for LM_PLANEREF_NONE slots.
LMPlane LMZeroPlane()
{
	LMPlane p;
	p.normal = vec3(0.0, 0.0, 1.0);
	p.D = 0.0;
	p.texZ = 0.0;
	return p;
}

// Resolve a planeRef to its plane (fetches the owning sector state).
LMPlane LMFetchPlane(float planeRef)
{
	int si; int pb;
	if (!LMSplitPlaneRef(planeRef, si, pb)) return LMZeroPlane();
	LMSectorState st = LMFetchSector(si);
	return LMGetPlane(st, pb);
}

// A zeroed sector state for LM_PLANEREF_NONE slots.
LMSectorState LMZeroSectorState()
{
	LMSectorState s;
	s.floor = LMZeroPlane();
	s.ceil  = LMZeroPlane();
	s.floorScroll = vec2(0.0);
	s.ceilScroll  = vec2(0.0);
	s.lightlevel   = 0.0;
	s.planeLight[0]= 0.0; s.planeLight[1]= 0.0;
	s.flags        = 0.0;
	s.glowFloorColor = vec4(0.0);
	s.glowFloorHeight = 0.0;
	s.glowCeilColor  = vec4(0.0);
	s.glowCeilHeight = 0.0;
	s.cmLightColor = vec3(255.0);
	s.cmBlendFactor  = 0.0;
	s.cmDesaturation = 0.0;
	s.cmFadeColor    = vec3(0.0);
	s.cmFogDensity   = 0.0;
	return s;
}

// Resolve a planeRef to its owning sector state (for the light chain).
LMSectorState LMFetchPlaneSector(float planeRef)
{
	int si; int pb;
	if (!LMSplitPlaneRef(planeRef, si, pb)) return LMZeroSectorState();
	return LMFetchSector(si);
}

// Plane z at a world (x, y) point: ZatPoint (secplane_t, p_local.h).
// DOOM space: z = (D - nx*x - ny*y) * negiC where negiC = 1/nz.
float LMPlaneZatPoint(LMPlane p, float x, float y)
{
	return (p.D - p.normal.x * x - p.normal.y * y) / p.normal.z;
}

// Convert a DOOM-space plane (nx, ny, nz) + D into the GPU-space glow/gradient
// plane encoding used by main.vp (x, z, y swap for y-up): (nx, nz, ny, D).
vec4 LMPlaneToGlowPlane(LMPlane p)
{
	return vec4(p.normal.x, p.normal.z, p.normal.y, p.D);
}

//
// main
//
void main()
{
	//
	// 1. Read the vertex attributes.
	//
	float x      = aPosition.x;
	float y      = aPosition.y;
	float slotA  = aPosition.z;   // baked z (static) / vparam (dynamic)
	float u      = aTexCoord.x;
	float slotB  = aTexCoord.y;   // baked v (static) / 0 (dynamic)
	float lmu    = aLightmap.x;
	float lmv    = aLightmap.y;
	int   surfIdx = int(aLightmap.z);

	float flags = 0.0;   // set from the surface record below.

	//
	// 2. Fetch the surface record.
	//
	LMSurface surf = LMFetchSurface(surfIdx);
	flags = surf.flags;

	bool isFlat    = (int(flags) & LMF_ISFLAT) != 0;
	bool isDynamic = (int(flags) & LMF_DYNAMIC) != 0;
	bool isSky     = (int(flags) & LMF_SKY) != 0;
	int   tier     = int(int(flags) & LMF_TIER_MASK) >> 8;   // 0 upper, 1 mid, 2 lower
	bool unpegged  = (int(flags) & LMF_UNPEGGEDLOWER) != 0;
	int   vparamSlot = tier;                                  // vparam index by tier

	//
	// 3. Fetch the four reference planes (front floor/ceil, back floor/ceil).
	//    LM_PLANEREF_NONE slots are left as a zero plane (texZ = 0).
	//
	LMPlane pFF = LMFetchPlane(surf.planeRef[0]);
	LMPlane pFC = LMFetchPlane(surf.planeRef[1]);
	LMPlane pBF = LMFetchPlane(surf.planeRef[2]);
	LMPlane pBC = LMFetchPlane(surf.planeRef[3]);

	//
	// 4. Compute the vertex z and v.
	//
	//    static  -> baked from the vertex (slotA = z, slotB = v).
	//    dynamic -> warp (blueprint 5.4): z = trackedPlane.TexZ + vparam[tier].
	//    The tracked plane is per-surface: front floor for upper/lower, front
	//    ceiling for middle (levelmesh.cpp wall emission). v is the window
	//    clamp from the four planes + vparam.
	//
	float z;
	float v;
	if (!isDynamic)
	{
		z = slotA;
		v = slotB;
	}
	else
	{
		// Tracked plane (per-surface, blueprint 5.4).
		LMPlane tracked = (tier == 1) ? pFC : pFF;
		z = tracked.texZ + surf.vparam[vparamSlot];

		// Window clamp (hw_walls.cpp DoMidTexture/DoTexture): the texture is
		// anchored to the reference plane; v = (referenceZ - z) in TexZ units.
		// referenceZ = the anchor plane's current TexZ (+ vparam offset).
		float referenceZ;
		if (tier == 1)
			referenceZ = pFC.texZ;                 // middle anchors to front ceiling
		else if (tier == 0)
			referenceZ = unpegged ? pFF.texZ : pBC.texZ;  // upper: front floor / back ceiling
		else
			referenceZ = unpegged ? pBF.texZ : pFF.texZ;  // lower: back floor / front floor
		v = (referenceZ - z) + surf.vparam[vparamSlot];
	}

	//
	// 5. Sky scroll / fade (blueprint 5.2, 5.3).
	//
	if (isSky)
	{
		int kind = int(surf.skyScrollKind);
		u += uLevelSkyPos[kind];
		// doublesky second layer (skyScrollKind2) is a per-fragment blend; the
		// VS only adds the primary scroll here.
	}

	//
	// 6. World position (GPU y-up: worldpos = (x, height, y)).
	//
	vec4 worldpos = vec4(x, z, y, 1.0);
	vec4 eyeCoord = ViewMatrix * worldpos;
	gl_Position = ProjectionMatrix * eyeCoord;

	//
	// 7. Standard varyings.
	//
	vTexCoord = vec4(u, v, 0.0, 1.0);
	pixelpos  = vec4(worldpos.xyz, -eyeCoord.z / eyeCoord.w);
	vLightmap = vec3(lmu, lmv, 0.0);

	// World/eye normal (aNormal is provided in GPU space by the C2 chunk).
	vWorldNormal = vec4(aNormal.xyz, 0.0);
	vEyeNormal   = vec4((NormalViewMatrix * vec4(aNormal.xyz, 0.0)).xyz, 0.0);
	gradientdist = vec3(0.0);   // levelmesh does not use gradients.

	//
	// 8. Light chain (blueprint "SUMMARY: EXACT CALL ORDER").
	//
	//    The per-surface light values are computed here and promoted to
	//    varyings. The sector state record carries the live lightlevel and the
	//    packed colormap; the light state record (lightlistRef) carries the
	//    live 3D light for light-listed surfaces.
	//
	// For both walls and flats the "front sector" light/colormap comes from
	// planeRef[0]'s sector (the flat's own sector for flats).
	// Colormap: from the front sector state, or the live 3D light record for
	// light-listed surfaces (12-byte record carries the light's colormap).
	LMSectorState lightSrc = LMFetchPlaneSector(surf.planeRef[0]);
	if (surf.lightlistRef >= 0.0)
	{
		lightSrc = LMFetchLight(int(surf.lightlistRef));
	}

	vec3  cmLight   = lightSrc.cmLightColor;
	float cmBlend   = lightSrc.cmBlendFactor;
	float cmDesat   = lightSrc.cmDesaturation;
	vec3  cmFade    = lightSrc.cmFadeColor;
	float cmFogDen  = lightSrc.cmFogDensity;

	// The builder bakes RescaleLightLevel + CalcRelLight into surf.light /
	// surf.relSmooth at build time (levelmesh.cpp:288-299), so the VS uses
	// them directly and only applies the runtime cvar-dependent steps
	// (CalcLightLevel, CalcLightColor, GetFogDensity).
	int lightlevel = int(surf.light);
	int rellight   = (isFlat ? 0 : int(surf.relSmooth)) + uWeaponLight;

	// CalcLightLevel (hwlightlevel) + CalcLightColor (vColor).
	int hwlightlevel = int(LM_CalcLightLevel(uLightMode, lightlevel, rellight, 0, int(cmBlend)));
	vec3 lightColor = LM_CalcLightColor(uLightMode, hwlightlevel, cmLight, int(cmBlend));
	vColor = vec4(lightColor / 255.0, 1.0);
	vLightLevel = float(hwlightlevel);
	vDesaturation = cmDesat;

	// GetFogDensity.
	bool noLightfade = (uLevelFlags3 & LEVEL3_NOLIGHTFADE) == 0u;
	int fogrgb = int(cmFade.r) | (int(cmFade.g) << 8) | (int(cmFade.b) << 16);
	vFogDensity = LM_GetFogDensity(uLightMode, lightlevel, fogrgb, 0, int(cmFogDen),
		int(cmBlend), int(uLevelFogDensity), int(uOutsideFogDensity),
		int(uOutsideFog & 0xffffffu), int(uOutsideFog >> 24), noLightfade);

	//
	// 9. Fog color / fog-enabled encoding (SetFog, hw_setcolor.cpp:88-152).
	//
	vec4 fogcolor = vec4(cmFade / 255.0, 0.0);
	int  fogenabled = 0;
	if (uRDistanceCullType > 1)
	{
		// cullcolor fog.
		vFogDensity = clamp(19200.0 / max(uCullDist, 1.0), 1.0, 255.0);
		fogcolor = (fogrgb != 0) ? fogcolor : vec4(uGlCullColor.rgb, 0.0);
	}
	if (uInsybox) vFogDensity += vFogDensity / 2.0;
	if (vFogDensity > 0.0 && uGlFogMode != 0)
	{
		fogenabled = (fogrgb == 0) ? uGlFogMode : -uGlFogMode;
	}
	vFogColor = fogcolor;
	vFogEnabled = fogenabled;

	//
	// 10. SetShaderLight (view-distance fade) + glow.
	//
	{
		float MAXDIST = 256.0 * (uRVisibility / 8.0);
		const float THRESHOLD = 96.0;
		const float FACTOR = 0.75;
		float level = float(lightlevel);
		float olight = float(rellight);
		if (level > 0.0)
		{
			float lightdist, lightfactor;
			if (olight < THRESHOLD)
			{
				lightdist = (MAXDIST / 2.0) + (olight * MAXDIST / THRESHOLD / 2.0);
				olight = THRESHOLD;
			}
			else lightdist = MAXDIST;
			lightfactor = 1.0 + ((olight / level) - 1.0) * FACTOR;
			if (lightfactor == 1.0) lightdist = 0.0;
			vLightFactor = lightfactor;
			vLightDist = lightdist;
		}
		else
		{
			vLightFactor = 1.0;
			vLightDist = 0.0;
		}
	}

	// Glow planes (frontsector ceiling/floor) + colors/heights from the front
	// sector's sector state record. GetWallGlow packing: (r,g,b) 0-255 with the
	// height in the 4th channel; c==0 is the texture-glow fallback (rgb==0) and
	// c==~0u is disabled (the a byte is set). The VS cannot do texture glow, so
	// the fallback emits no glow. The height is 0 in both sentinel cases.
	LMSectorState frontSec = LMFetchPlaneSector(surf.planeRef[0]);
	vec4  topGlow = frontSec.glowCeilColor;   // (r,g,b,a) 0-255
	vec4  botGlow = frontSec.glowFloorColor;  // (r,g,b,a) 0-255
	float topH = (topGlow.a > 0.5 || (topGlow.r < 0.5 && topGlow.g < 0.5 && topGlow.b < 0.5)) ? 0.0 : frontSec.glowCeilHeight;
	float botH = (botGlow.a > 0.5 || (botGlow.r < 0.5 && botGlow.g < 0.5 && botGlow.b < 0.5)) ? 0.0 : frontSec.glowFloorHeight;
	vGlowTopPlane    = LMPlaneToGlowPlane(pFC);
	vGlowBottomPlane = LMPlaneToGlowPlane(pFF);
	vGlowTopColor    = vec4(topGlow.rgb / 255.0, topH);
	vGlowBottomColor = vec4(botGlow.rgb / 255.0, botH);

	// glowdist is computed in the fragment path from vGlowTop/BottomPlane;
	// the VS leaves it at 0 (the engine prelude declares it).
	glowdist = vec3(0.0);
}
